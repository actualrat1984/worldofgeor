{
  "name": "worldofgeor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run build:css",
    "dev": "vite --configLoader bundle",
    "build": "npm run build:vite",
    "build:css": "tailwindcss -c tailwind.config.js -i src/style.css -o public/site.css --minify",
    "build:vite": "npm run build:css && vite build --configLoader bundle",
    "build:wiki": "node scripts/build-wiki.mjs",
    "check:site": "node scripts/check-site.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "verify": "node --test tests/*.test.mjs && node scripts/check-site.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.10",
    "vite": "^6.4.3"
  }
}
